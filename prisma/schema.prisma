// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  Board   Board?  @relation("sharedWithRelation", fields: [boardId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  boardId String? @db.ObjectId
  Boards  Board[] @relation("createdByRelation")
  Task    Task[]
}

model Board {
  id         String      @id @map("_id") @db.ObjectId
  name       String      @unique
  sharedWith User[]      @relation("sharedWithRelation")
  createdBy  User        @relation("createdByRelation", fields: [userId], references: [id])
  updateAt   DateTime    @updatedAt
  userId     String      @db.ObjectId
  BoardList  BoardList[]
}

model BoardList {
  id          String   @id @map("_id") @db.ObjectId
  name        String   @unique
  boardId     String   @db.ObjectId
  boardDetail Board    @relation(fields: [boardId], references: [id])
  createdAt   DateTime @default(now())
  updateAt    DateTime @updatedAt
  Task        Task[]
}

model Task {
  id               String        @id @map("_id") @db.ObjectId
  name             String
  description      String
  deadline         DateTime
  priorityLevel    PriorityLevel @default(value: Low)
  assignedTo       String        @db.ObjectId
  boardListId      String        @db.ObjectId
  createdAt        DateTime      @default(now())
  updateAt         DateTime      @updatedAt
  assignedToDetail User          @relation(fields: [assignedTo], references: [id])
  boardListDetail  BoardList     @relation(fields: [boardListId], references: [id])
}

enum PriorityLevel {
  Low
  Medium
  High
}
