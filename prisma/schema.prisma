// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  created  Board[]  @relation("createdByRelation")
  task     Task[]
  shared   Board[]  @relation("sharedWithRelation", fields: [boardIds], references: [id])
  boardIds String[] @db.ObjectId
}

model Board {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  sharedWith    User[]      @relation("sharedWithRelation", fields: [sharedWithIds], references: [id])
  user          User        @relation("createdByRelation", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt     DateTime    @default(now())
  updateAt      DateTime    @updatedAt
  userId        String      @db.ObjectId
  sharedWithIds String[]    @db.ObjectId
  BoardList     BoardList[]
}

model BoardList {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  boardId     String   @db.ObjectId
  boardDetail Board    @relation(fields: [boardId], references: [id])
  createdAt   DateTime @default(now())
  updateAt    DateTime @updatedAt
  Task        Task[]
}

model Task {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  description      String
  deadline         DateTime      @db.Date()
  priorityLevel    PriorityLevel @default(value: Low)
  assignedTo       String?       @db.ObjectId
  boardListId      String        @db.ObjectId
  createdAt        DateTime      @default(now())
  updateAt         DateTime      @updatedAt
  assignedToDetail User?         @relation(fields: [assignedTo], references: [id])
  boardListDetail  BoardList     @relation(fields: [boardListId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

enum PriorityLevel {
  Low
  Medium
  High
}
